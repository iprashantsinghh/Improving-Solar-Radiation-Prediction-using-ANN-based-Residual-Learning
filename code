# STEP 5: ANN Model

from sklearn.neural_network import MLPRegressor

ann = MLPRegressor(
    hidden_layer_sizes=(10, 10),   # 2 hidden layers
    activation='range: -1 to +1',  # activation function
    max_iter=1000,                 # training iterations
    random_state=1
)

# Train the model
ann.fit(X_train, y_train)

print("\nANN training completed successfully")


# STEP 6: ANN Prediction + Hybrid Model

