import pandas as pd
import os
folder_path = "solar_data"
all_data = []

for file in os.listdir(folder_path):
    if file.endswith(".xls") or file.endswith(".xlsx"):
        file_path = os.path.join(folder_path, file)

      
        df_temp = pd.read_excel(file_path, skiprows=4)

        all_data.append(df_temp)


df = pd.concat(all_data, ignore_index=True)

print("Raw merged rows:", len(df))


if 'Unnamed: 0' in df.columns:
    df = df.drop(columns=['Unnamed: 0'])

df['Timestamp'] = pd.to_datetime(df['Timestamp'], errors='coerce')

df = df.dropna(subset=['Timestamp'])

df = df.reset_index(drop=True)
    
print("Cleaned_rows:", len(df))
print("Columns:", df.columns)

print("\n hourly radiation values:")
print(df[['Timestamp','Radiation']].head(10))


df['Date'] = df['Timestamp'].dt.date


daily_df = df.groupby('Date').agg({
    'Air_Temp': ['max', 'min'],
    'RH(%)': 'mean',
    'Radiation': 'mean'
}).reset_index()

daily_df.columns = ['Date', 'Tmax', 'Tmin', 'RH', 'Radiation']


print(daily_df.head())
print("\nDaily Data:")
print(daily_df.head())
print("Total days:", len(daily_df))

print("\nAlong with Model Variables:")
print(daily_df.head())
import numpy as np

phi = np.radians(18.1841)

daily_df['n'] = pd.to_datetime(daily_df['Date']).dt.dayofyear

daily_df['delta'] = np.radians(
    23.45 * np.sin(np.radians((360/365)*(284 + daily_df['n'])))
)

daily_df['ws'] = np.arccos(-np.tan(phi) * np.tan(daily_df['delta']))

Gsc = 0.0820  

daily_df['dr'] = 1 + 0.033 * np.cos(np.radians((360/365)*daily_df['n']))

daily_df['H0'] = (
    (24*60/np.pi) * Gsc * daily_df['dr'] *
    (
        daily_df['ws']*np.sin(phi)*np.sin(daily_df['delta']) +
        np.cos(phi)*np.cos(daily_df['delta'])*np.sin(daily_df['ws'])
    )
)

print("\nRadiation vs H0:")
print(daily_df[['Radiation','H0']].head())
daily_df['Radiation'] = daily_df['Radiation'] * 86400 / 1e6
print("\nRadiation vs H0(after conversion):")
print(daily_df[['Radiation','H0']].head())
daily_df['H-actual'] = daily_df['Radiation']
# Temperature ratio
daily_df['theta'] = daily_df['Tmin'] / daily_df['Tmax']

# Sunshine ratio proxy (since SS not available)
daily_df['SS_ratio'] = daily_df['Radiation'] / daily_df['Radiation'].max()

# Define S and H0
S = daily_df['SS_ratio']
H0 = daily_df['H0']
